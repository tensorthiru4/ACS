# Local development settings. Never commit a real .env.
ACS_ENV=local
ACS_PUBLIC_BASE_URL=http://localhost:8080
ACS_GEMINI_MODEL=gemini-3.8-flash

# Leave empty to use in-memory Firestore / Pub/Sub / sessions.
ACS_PROJECT_ID=

# Downstream agents (empty = feature disabled; refunds then fail safe to ESCALATE).
ACS_AUDITOR_URL=
ACS_POLICY_COMPILER_URL=
ACS_RULE_ENGINE_URL=

# Google AI Studio key (free tier) used by ADK for Gemini.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Fallback when Gemini is out of quota or overloaded: Gemma on the same key (empty = off).
ACS_FALLBACK_MODEL=gemma-4-31b-it

ACS_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

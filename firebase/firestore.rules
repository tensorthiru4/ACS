rules_version = '2';

// Firestore is reached only by ACS services through their service accounts (IAM),
// which bypass these rules. Browser and mobile clients get no direct access:
// sessions, rule sets, draft SOs, credentials and the SKU index stay server-side.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

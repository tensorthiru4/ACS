# Copy to .env.local and fill in. Firebase web config values are public identifiers
# (access is enforced by Firebase Auth, the API Gateway and the orchestrator).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
# `terraform output -raw gateway_url`
VITE_API_BASE=https://<gateway>.gateway.dev
